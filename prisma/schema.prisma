generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  name          String?
  image         String?
  emailVerified DateTime?       @map("emailVerifiedAt")
  createdAt     DateTime        @default(now())
  accounts      Account[]
  favorites     Favorite[]
  invitations   Invitation[]
  memberships   OrgMembership[]
  organizations Organization[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Address {
  id        String   @id @default(uuid())
  name      String
  address   String
  phone     String
  email     String?
  website   String?
  orgId     String
  createdAt DateTime @default(now())
}

model EmailOTP {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, expiresAt])
}

model Invitation {
  orgId           String
  email           String
  role            String
  tokenHash       String           @unique
  invitedByUserId String?
  status          InvitationStatus @default(PENDING)
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  invitedByUser   User?            @relation(fields: [invitedByUserId], references: [id])
  org             Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([orgId, email], name: "invitationId")
  @@index([orgId, email, status])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Organization {
  id                       String                    @id @default(uuid())
  name                     String
  slug                     String                    @unique
  ownerUserId              String
  plan                     String                    @default("business")
  entitlementsJSON         Json                      @default("{}")
  createdAt                DateTime                  @default(now())
  currentPeriodEnd         DateTime?
  stripeCustomerId         String?                   @unique
  stripeSubscriptionId     String?                   @unique
  stripeSubscriptionStatus StripeSubscriptionStatus?
  departments              Department[]
  ingestionJobs            IngestionJob[]
  invitations              Invitation[]
  memberships              OrgMembership[]
  ownerUser                User                      @relation(fields: [ownerUserId], references: [id])
}

model OrgMembership {
  id        String            @id @default(uuid())
  orgId     String
  userId    String
  createdAt DateTime          @default(now())
  role      OrgMembershipRole
  org       Organization      @relation(fields: [orgId], references: [id])
  user      User              @relation(fields: [userId], references: [id])

  @@unique([orgId, userId])
  @@index([userId])
}

model Department {
  id        String       @id @default(uuid())
  orgId     String
  name      String
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  teams     Team[]

  @@index([orgId, name])
}

model Team {
  id           String         @id @default(uuid())
  departmentId String
  name         String
  createdAt    DateTime       @default(now())
  categories   Category[]
  ideas        Idea[]
  newsPost     NewsPost[]
  process      Process[]
  ProcessChunk ProcessChunk[]
  department   Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([departmentId, name])
}

model Category {
  id        String    @id @default(uuid())
  teamId    String
  name      String
  sortOrder Int       @default(0)
  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  processes Process[]

  @@index([teamId, sortOrder])
}

model Process {
  id                 String           @id @default(uuid())
  teamId             String
  categoryId         String?
  slug               String
  title              String
  description        String?
  pendingVersionId   String?          @unique
  publishedVersionId String?          @unique
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  style              ProcessStyle
  status             ProcessStatus
  errorReports       ErrorReport[]
  favorites          Favorite[]
  ingestionJobs      IngestionJob[]
  category           Category?        @relation(fields: [categoryId], references: [id])
  pendingVersion     ProcessVersion?  @relation("PendingVersion", fields: [pendingVersionId], references: [id])
  publishedVersion   ProcessVersion?  @relation("PublishedVersion", fields: [publishedVersionId], references: [id])
  team               Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  ProcessChunk       ProcessChunk[]
  versions           ProcessVersion[]

  @@unique([teamId, slug])
  @@index([teamId, categoryId])
  @@index([teamId, title])
  @@index([teamId, slug])
}

model ProcessVersion {
  id            String         @id @default(uuid())
  processId     String
  createdBy     String
  createdAt     DateTime       @default(now())
  contentJSON   Json
  contentText   String?
  style         ProcessStyle
  ingestionJobs IngestionJob[]
  pendingOf     Process?       @relation("PendingVersion")
  publishedOf   Process?       @relation("PublishedVersion")
  process       Process        @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@index([processId, createdAt])
}

model ProcessChunk {
  id         String                 @id @default(uuid())
  processId  String
  teamId     String
  title      String
  chunkIndex Int
  chunkText  String
  embedding  Unsupported("vector")?
  createdAt  DateTime               @default(now())
  process    Process                @relation(fields: [processId], references: [id], onDelete: Cascade)
  team       Team                   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, processId])
  @@index([processId, chunkIndex])
}

model NewsPost {
  id        String   @id @default(uuid())
  teamId    String
  title     String
  bodyJSON  Json
  pinned    Boolean  @default(false)
  createdBy String
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, createdAt])
}

model Favorite {
  userId    String
  processId String
  process   Process @relation(fields: [processId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, processId])
  @@index([userId])
  @@index([processId])
}

model Idea {
  id        String     @id @default(uuid())
  teamId    String
  createdBy String
  title     String
  body      String
  createdAt DateTime   @default(now())
  status    IdeaStatus @default(NEW)
  team      Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, status, createdAt])
}

model ErrorReport {
  id        String            @id @default(uuid())
  processId String
  createdBy String
  body      String
  createdAt DateTime          @default(now())
  status    ErrorReportStatus @default(OPEN)
  process   Process           @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@index([processId, status, createdAt])
}

model IngestionJob {
  id              String             @id @default(uuid())
  orgId           String
  processId       String
  sourceType      String
  fileKey         String?
  error           String?
  outputVersionId String?
  createdAt       DateTime           @default(now())
  status          IngestionJobStatus
  org             Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  outputVersion   ProcessVersion?    @relation(fields: [outputVersionId], references: [id])
  process         Process            @relation(fields: [processId], references: [id], onDelete: Cascade)

  @@index([orgId, status, createdAt])
  @@index([processId, status, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  orgId      String
  actorId    String
  action     String
  entityType String
  entityId   String
  at         DateTime @default(now())
  beforeJSON Json?
  afterJSON  Json?
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum StripeSubscriptionStatus {
  active
  incomplete
  incomplete_expired
  past_due
  canceled
  unpaid
  trialing
  paused
}

enum OrgMembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum ProcessStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProcessStyle {
  RAW
  STEPS
  FLOW
  YESNO
}

enum IdeaStatus {
  NEW
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum ErrorReportStatus {
  OPEN
  RESOLVED
  ARCHIVED
}

enum IngestionJobStatus {
  QUEUED
  PARSING
  GENERATING
  FAILED
  READY
}
