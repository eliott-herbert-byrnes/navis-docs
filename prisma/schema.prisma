generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String          @id @default(uuid())
  email               String          @unique
  canonicalEmail      String          @unique
  name                String?
  image               String?
  emailVerified       DateTime?       @map("emailVerifiedAt")
  createdAt           DateTime        @default(now())
  accounts            Account[]
  auditExportJobs     AuditExportJob[]
  favorites           Favorite[]
  invitations         Invitation[]
  memberships         OrgMembership[]
  organizations       Organization[]
  userProcedureRead   UserProcedureRead[]
  userNewsRead        UserNewsRead[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Address {
  id        String       @id @default(uuid())
  name      String
  address   String
  phone     String
  email     String?
  website   String?
  orgId     String
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model EmailOTP {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, expiresAt])
}

model Invitation {
  orgId            String
  email            String
  canonicalEmail   String
  role             String
  tokenHash        String           @unique
  invitedByUserId  String?
  status           InvitationStatus @default(PENDING)
  expiresAt        DateTime
  acceptedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  invitedByUser    User?            @relation(fields: [invitedByUserId], references: [id])
  org              Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([orgId, canonicalEmail], name: "invitationId")
  @@index([orgId, email, status])
  @@index([orgId, canonicalEmail, status])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum OrgPlan {
  pro
  enterprise
  free
}

model Organization {
  id                       String                    @id @default(uuid())
  name                     String
  slug                     String                    @unique
  ownerUserId              String
  plan                     OrgPlan                   @default(pro)
  entitlementsJSON         Json                      @default("{}")
  anthropicApiKey          String?
  openAiApiKey             String?
  createdAt                DateTime                  @default(now())
  currentPeriodEnd         DateTime?
  billingGraceEndsAt       DateTime?
  stripeCustomerId         String?                   @unique
  stripeSubscriptionId     String?                   @unique
  stripeSubscriptionStatus StripeSubscriptionStatus?
  auditExportJobs          AuditExportJob[]
  departments              Department[]
  ingestionJobs            IngestionJob[]
  invitations              Invitation[]
  memberships              OrgMembership[]
  procedureRollout         ProcedureRollout[]
  addresses                Address[]
  ownerUser                User                      @relation(fields: [ownerUserId], references: [id])

  @@index([ownerUserId])
}

model OrgMembership {
  id                  String              @id @default(uuid())
  orgId               String
  userId              String
  createdAt           DateTime            @default(now())
  compliant           Boolean             @default(true)
  role                OrgMembershipRole
  org                 Organization        @relation(fields: [orgId], references: [id])
  user                User                @relation(fields: [userId], references: [id])

  @@unique([orgId, userId])
  @@index([userId])
}

model Department {
  id        String            @id @default(uuid())
  orgId     String
  name      String
  createdAt DateTime          @default(now())
  iconKey   String            @default("users")
  org       Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  teams     Team[]

  @@index([orgId, name])
}

model Team {
  id           String         @id @default(uuid())
  departmentId String
  name         String
  createdAt    DateTime       @default(now())
  categories   Category[]
  ideas        Idea[]
  newsPost     NewsPost[]
  procedure    Procedure[]
  procedureChunk ProcedureChunk[]
  department   Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@index([departmentId, name])
}

model Category {
  id        String    @id @default(uuid())
  teamId    String
  name      String
  sortOrder Int       @default(0)
  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  procedures Procedure[]

  @@index([teamId, sortOrder])
}

model Procedure {
  id                 String           @id @default(uuid())
  teamId             String
  categoryId         String?
  slug               String
  title              String
  description        String?
  pendingVersionId   String?          @unique
  publishedVersionId String?          @unique
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  notifyOnPublish    Boolean         @default(false)
  notifyRoleFilter   RolloutRoleFilter?
  emailOnPublish     Boolean          @default(false)
  emailRoleFilter    RolloutRoleFilter?
  newsOnPublish      Boolean           @default(false)
  style              ProcedureStyle
  status             ProcedureStatus
  errorReports       ErrorReport[]
  favorites          Favorite[]
  ingestionJobs      IngestionJob[]
  category           Category?        @relation(fields: [categoryId], references: [id])
  pendingVersion     ProcedureVersion?  @relation("PendingVersion", fields: [pendingVersionId], references: [id])
  publishedVersion   ProcedureVersion?  @relation("PublishedVersion", fields: [publishedVersionId], references: [id])
  team               Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  ProcedureChunk     ProcedureChunk[]
  versions           ProcedureVersion[]
  procedureRollout   ProcedureRollout[]
  userProcedureRead  UserProcedureRead[]

  @@unique([teamId, slug])
  @@index([teamId, categoryId])
  @@index([teamId, title])
  @@index([teamId, slug])
}

model ProcedureRollout {
  id                String             @id @default(uuid())   
  procedureId       String
  versionId         String
  orgId             String
  notifyRoleFilter  RolloutRoleFilter
  emailRoleFilter   RolloutRoleFilter?
  rolloutType       RolloutType
  createdAt         DateTime           @default(now())
  newsPostId        String?

  @@index([orgId, procedureId, versionId])
  procedure         Procedure           @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  version           ProcedureVersion    @relation(fields: [versionId], references: [id], onDelete: Cascade)
  org               Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  news              NewsPost?           @relation(fields: [newsPostId], references: [id], onDelete: Cascade)
}

enum RolloutType {
  NEW
  EDIT
}

model UserProcedureRead {
  id                String             @id @default(uuid())   
  userId            String
  procedureId       String
  versionId         String
  readAt            DateTime           @default(now())

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  procedure         Procedure          @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  version           ProcedureVersion   @relation(fields: [versionId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@unique([userId, procedureId, versionId])
}

model ProcedureVersion{
  id                  String         @id @default(uuid())
  procedureId         String
  createdBy           String
  createdAt           DateTime       @default(now())
  contentJSON         Json
  contentText         String?
  style               ProcedureStyle
  ingestionJobs       IngestionJob[]
  procedureRollout    ProcedureRollout[]
  pendingOf           Procedure?       @relation("PendingVersion")
  publishedOf         Procedure?       @relation("PublishedVersion")
  procedure           Procedure        @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  userProcedureRead   UserProcedureRead[]

  @@index([procedureId, createdAt])
}

model ProcedureChunk {
  id            String                 @id @default(uuid())
  procedureId   String
  teamId     String
  title      String
  chunkIndex Int
  chunkText  String
  embedding  Unsupported("vector")?
  createdAt  DateTime               @default(now())
  procedure  Procedure              @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  team       Team                   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, procedureId])
  @@index([procedureId, chunkIndex])
}

model NewsPost {
  id        String   @id @default(uuid())
  teamId    String
  title     String
  bodyJSON  Json
  pinned    Boolean  @default(false)
  createdBy String
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  procedureRollout    ProcedureRollout[]
  userNewsRead       UserNewsRead[]

  @@index([teamId, createdAt])
}

model UserNewsRead {
  id         String   @id @default(uuid())
  userId     String
  newsPostId String
  readAt     DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  newsPost NewsPost @relation(fields: [newsPostId], references: [id], onDelete: Cascade)

  @@unique([userId, newsPostId])
  @@index([userId])
  @@index([newsPostId])
}

model Favorite {
  userId      String
  procedureId String
  procedure   Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, procedureId])
  @@index([userId])
  @@index([procedureId])
}

model Idea {
  id        String     @id @default(uuid())
  teamId    String
  createdBy String
  title     String
  body      String
  createdAt DateTime   @default(now())
  status    IdeaStatus @default(NEW)
  team      Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, status, createdAt])
}

model ErrorReport {
  id          String            @id @default(uuid())
  procedureId String
  createdBy   String
  body        String
  createdAt   DateTime          @default(now())
  status      ErrorReportStatus @default(OPEN)
  procedure   Procedure           @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  @@index([procedureId, status, createdAt])
}

model IngestionJob {
  id              String             @id @default(uuid())
  orgId           String
  procedureId     String
  sourceType      String
  fileKey         String?
  error           String?
  outputVersionId String?
  createdAt       DateTime           @default(now())
  status          IngestionJobStatus
  org             Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  outputVersion   ProcedureVersion?    @relation(fields: [outputVersionId], references: [id])
  procedure       Procedure            @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  @@index([orgId, status, createdAt])
  @@index([procedureId, status, createdAt])
  @@index([outputVersionId])
}

/// Async org-wide audit log JSON export (storage path in fileKey when READY).
model AuditExportJob {
  id                String               @id @default(uuid())
  orgId             String
  requestedByUserId String
  /// Snapshot of export filters at request time (search, entityType, date range as ISO strings, etc.).
  filtersJson       Json
  fileKey           String?
  error             String?
  expiresAt         DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  status            AuditExportJobStatus
  org               Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  requestedByUser   User                 @relation(fields: [requestedByUserId], references: [id], onDelete: Cascade)

  @@index([orgId, status, createdAt])
  @@index([orgId, requestedByUserId, status, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  orgId      String
  actorId    String
  action     String
  entityType String
  entityId   String
  at         DateTime @default(now())
  beforeJSON Json?
  afterJSON  Json?
  @@index([orgId, entityType, entityId, at])
  @@index([orgId, actorId, at])
}

model StripeWebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
  createdAt   DateTime @default(now())
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum StripeSubscriptionStatus {
  active
  incomplete
  incomplete_expired
  past_due
  canceled
  unpaid
  trialing
  paused
}

enum OrgMembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum RolloutRoleFilter {
  ALL_USERS
  ADMINS_ONLY
  MEMBERS_ONLY
}

enum ProcedureStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProcedureStyle {
  RAW
  STEPS
  FLOW
  YESNO
}

enum IdeaStatus {
  NEW
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum ErrorReportStatus {
  OPEN
  RESOLVED
  ARCHIVED
}

enum IngestionJobStatus {
  QUEUED
  PARSING
  GENERATING
  FAILED
  READY
}

enum AuditExportJobStatus {
  QUEUED
  PROCESSING
  READY
  FAILED
}
