# Navis Docs — environment variables
#
# Copy this file to `.env` and fill in your values. Never commit `.env`.
# Generate random secrets with: openssl rand -base64 32

# ─── Database ─────────────────────────────────────────────
# Postgres connection string (pgvector required). Many hosts use a pooler URL with ?pgbouncer=true
DATABASE_URL=postgresql://postgres:password@localhost:5432/navis_docs
# Optional: direct Postgres URL for Prisma migrations when DATABASE_URL uses a pooler (common on Supabase).

# ─── Storage (choose one: supabase | s3) ──────────────────
# Used by server code for object storage (procedure images, imports, audit exports).
STORAGE_PROVIDER=s3
# S3-compatible (AWS S3, Cloudflare R2, Garage, etc.)
S3_ENDPOINT= # leave blank for AWS, set for R2/Garage
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PROCEDURE_IMAGES_BUCKET=procedure-images
S3_PROCEDURE_IMPORTS_BUCKET=procedure-imports
S3_PROCEDURE_AUDITS_BUCKET=audit-exports
# OR: Supabase Storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Redis ────────────────────────────────────────────────
# Used for shared rate limiting / Redis access. 
REDIS_URL=redis://localhost:6379

# ─── Auth (Auth.js / NextAuth v5) ─────────────────────────
# Required: secret used to sign sessions. Auth.js also accepts NEXTAUTH_SECRET as an alias.
AUTH_SECRET=
NEXTAUTH_URL=https://your-domain.com
# Optional: Google OAuth sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: set true when the app sits behind a reverse proxy (Auth.js / Next.js)
# AUTH_TRUST_HOST=true

# ─── Email (Resend) ───────────────────────────────────────
# API key from https://resend.com — required when sending OTP, invites, or mail from the app
RESEND_API_KEY=
# Will centralize From addresses; verify your domain in Resend
EMAIL_FROM=Navis Docs <no-reply@your-domain.com>

# ─── AI (optional — features degrade without keys) ────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Required if organizations store BYO API keys (encrypts at rest)
AI_KEY_ENCRYPTION_SECRET= # generate: openssl rand -base64 32

# ─── Stripe (required for cloud; omit for self-hosted) ────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_DEFAULT_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ─── App ───────────────────────────────────────────────────
# Canonical public site URL (links, metadata, Stripe return URLs)
NEXT_PUBLIC_APP_URL=https://your-domain.com
# BUILD-TIME: "cloud" vs "self-hosted" — controls client bundles that gate billing/AI UI
NEXT_PUBLIC_DEPLOY_MODE=self-hosted

# ─── Demo (production marketing iframe only) ────────────────
# Base URL for the live demo embed on navisdocs.com — appends /dashboard. Do NOT set on the demo Vercel project.
# NEXT_PUBLIC_DEMO_URL=https://demo.navisdocs.com

# ─── Demo deployment only (separate Vercel project + DB) ───
# Do NOT set these on production. Build fails if demo vars exist without DEMO_MODE=true.
# NEXT_PUBLIC_DEMO_MODE=true
# NEXT_PUBLIC_DEMO_HOST=demo.navisdocs.com
# NEXT_PUBLIC_APP_URL=https://demo.navisdocs.com
# DEMO_ORG_ID=
# DEMO_USER_ID=
# DEMO_MEMBER_USER_ID=  # optional; fixed UUID for the demo member user

# ─── CI / hosting (optional — local dev can ignore) ───────
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=

# ─── Database seed / scripts (optional) ───────────────────
# SEED_ORG_SLUG=demo-organization
